| ========================================================== |
| Hệ thống Quản lý Bộ nhớ đệm Đa tầng (.ko v2.505)           |
| ========================================================== |

manage_cache(int~key, string~data) [
    <printf>^("[SUCCESS] Access Key {key} -> Address: 0x7ff8a1200b0 | Data: {data}\n")
    
    | Tối ưu hóa Cache Line qua Subsystem Loop.cpp |
    <printf>^("[LOOP OPTIMIZER] Cache line refreshed via Loop.cpp Subsystem.\n")
    
    | Lưu tạm key vào biến tĩnh trước khi giải phóng ô nhớ |
    int(key)~saved_key
    <memory>dete(key)
    <printf>^("[MEMORY] Deallocated address segment for Key {saved_key} successfully.\n")
    <return>(\True\)
]

[
    | 1. Dòng khởi tạo tiêu chuẩn Output Thủy Tối |
    <printf>^("=== KO ENGINE CACHE SYSTEM INITIALIZATION ===\n")

    | 2. Khai báo Dictionary cache_map theo chuẩn Mục III.2 (dùng nháy đơn) |
    (101{'UserData_A'})~cache_map

    | 3. Thực thi quản lý cache |
    ~manage_cache(101, "UserData_A")

    | 4. Bắt lỗi KeyNotFoundError ngay trong scope Main khi truy xuất key 999 |
    <catch>(`KeyNotFoundError`) [
        <printf>^("[CATCH DETECTED] Error `KeyNotFoundError` at line 42: cache_map<999>. Recovery executed.\n")
    ]

    string("")~val
    <now>(cache_map<999>)>val

    | 5. Trạng thái hệ thống |
    booling(\True\)~sys_status
    <printf>^("[STATUS] System active state: {sys_status}\n")
]